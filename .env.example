# =============================================================================
# Overtime Report Configuration
# Copy this file to .env and adjust values
# =============================================================================

# --- Solidtime Database Connection ---
# Container name of your Solidtime PostgreSQL database
# If using docker network, use the container name as host
DB_HOST=solidtime-database-1
DB_PORT=5432
DB_NAME=solidtime
DB_USER=solidtime
DB_PASS=solidtime

# --- Employee / Member Configuration ---
# Your member_id from Solidtime (UUID)
# Find via: docker exec solidtime-database-1 psql -U solidtime -d solidtime \
#   -c "SELECT m.id, u.name, u.email FROM members m JOIN users u ON m.user_id = u.id"
MEMBER_ID=your-member-uuid-here

# Optional: Primary employer client ID (informational, not used for filtering)
# Find via: docker exec solidtime-database-1 psql -U solidtime -d solidtime \
#   -c "SELECT id, name FROM clients"
PRIMARY_CLIENT_ID=

# Optional: Exclude specific client IDs from overtime calculation (comma-separated)
# E.g., personal side-projects that are not employer-related
EXCLUDE_CLIENTS=

# Optional: THW/volunteer client ID - weekend entries are excluded (personal volunteer work)
# Weekday entries during work hours count as employer-paid leave
THW_CLIENT_ID=

# --- Personal Information ---
EMPLOYEE_NAME=Max Mustermann
EMPLOYEE_ROLE=IT Administrator
HOURS_PER_WEEK=39
VACATION_DAYS=30
START_DATE=2024-01-01

# --- German State for Holiday Calculation ---
# Supported: BW, BY, BE, BB, HB, HH, HE, MV, NI, NW, RP, SL, SN, ST, SH, TH
STATE=BY

# --- Output Directories (inside container) ---
OUTPUT_DIR_REAL=/output/real
OUTPUT_DIR_OFFICE=/output/office

# --- Email Configuration (Gmail SMTP) ---
# For Gmail: Use an App Password (not your regular password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_TO=chef@example.com
MAIL_CC=

# --- Google Drive Sync (rclone) ---
# See docs/ADMIN.md for rclone setup
RCLONE_REMOTE=gdrive
RCLONE_PATH=Arbeitszeitnachweis

# Optional: Google Drive folder URL (shown in monthly email)
REPORT_URL=

# Optional: URL to calculation documentation (shown in monthly email)
DOCS_URL=
